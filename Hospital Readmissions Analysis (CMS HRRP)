## Rename Conditions
labels = {
    "READM-30-AMI-HRRP": "Heart attack (AMI)",
    "READM-30-CABG-HRRP" : 'CABG surgery',
    'READM-30-COPD-HRRP': 'COPD',
    'READM-30-HF-HRRP': 'Heart failuer',
    'READM-30-HIP-KNEE-HRRP': ' Hip/knee replacement',
    'READM-30-PN-HRRP': 'Pneumonia'
}
df['Condition'] = df['Measure Name'].map(labels).fillna(df['Measure Name'])

### Analyse Indicatos 
state = None        # e.g. 'NY' to focus on one state, or None for national
focus = df if state is None else df[df['State'] == state]
focus = focus.copy()

focus['worse_than_expected'] = focus['Excess Readmission Ratio'] > 1
focus['excess_readmissions'] = ((focus['Predicted Readmission Rate']
                                 - focus['Expected Readmission Rate'])
                                / 100 * focus['Number of Discharges'])
focus['err_x_dis'] = focus['Excess Readmission Ratio'] * focus['Number of Discharges']

g = focus.groupby('Condition')
summary = pd.DataFrame({
    'hospitals': g.size(),
    'pct_worse': g['worse_than_expected'].mean() * 100,
    'weighted_err': g['err_x_dis'].sum() / g['Number of Discharges'].sum(),
    'net_excess_readmissions': g['excess_readmissions'].sum(),
    'gross_excess_readmissions': g['excess_readmissions'].apply(lambda s: s[s > 0].sum()),
}).round(2).sort_values('net_excess_readmissions', ascending=False)

