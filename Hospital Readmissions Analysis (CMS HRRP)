num_cols=['Excess Readmission Ratio', 'Predicted Readmission Rate',
          'Expected Readmission Rate','Number of Discharges']

df=data.copy()

for c in num_cols:
  df[c]=pd.to_numeric(df[c] , errors='coerce')

n_before = len(df)
df=df.dropna(subset = ['Excess Readmission Ratio'])
n_dropped = n_before - len(df)

print(f"Dropped {n_dropped} of {n_before} rows ({n_dropped/n_before:.1%}) with no ERR")
