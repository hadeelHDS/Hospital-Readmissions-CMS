##### Colours, charts and page layout#####

import pandas as pd
import plotly.graph_objects as go

# ---- Colour system: each condition keeps the same colour in every chart ----
COND_COLORS = {
    'Heart failure': '#7B2CBF',        # purple
    'Pneumonia': '#3A86FF',            # blue
    'COPD': '#00B4D8',                 # cyan
    'Heart attack (AMI)': '#FF006E',   # magenta
    'CABG surgery': '#FB8500',         # orange
    'Hip/knee replacement': '#FFBE0B', # amber
}
WORSE, BETTER, NAVY = '#E63946', '#2A9D8F', '#14213D'
FONT = 'Figtree, Segoe UI, Arial, sans-serif'
CONFIG = {'displayModeBar': False, 'responsive': True}


def color_of(cond):
    return COND_COLORS.get(cond, '#8D99AE')


def style(fig, height=380):
    fig.update_layout(font=dict(family=FONT, size=13, color='#33415C'),
                      paper_bgcolor='rgba(0,0,0,0)', plot_bgcolor='rgba(0,0,0,0)',
                      height=height, margin=dict(l=10, r=30, t=10, b=10),
                      hoverlabel=dict(font_family=FONT))
    fig.update_xaxes(gridcolor='#E9EDF5', zeroline=False)
    fig.update_yaxes(gridcolor='#E9EDF5', zeroline=False)
    return fig


def state_table(df, condition):
    c = df[df['Condition'] == condition]
    s = c.groupby('State')[['err_x_dis', 'Number of Discharges']].sum()
    s['Weighted ERR'] = s['err_x_dis'] / s['Number of Discharges']
    return s.dropna().reset_index()[['State', 'Weighted ERR']]


# ---------------- Charts ----------------
def chart_excess(summary):
    s = summary.sort_values('Gross excess readmissions')
    fig = go.Figure(go.Bar(
        x=s['Gross excess readmissions'], y=s['Condition'], orientation='h',
        marker=dict(color=[color_of(c) for c in s['Condition']]),
        text=[f'{v:,.0f}' for v in s['Gross excess readmissions']], textposition='outside',
        hovertemplate='%{y}: %{x:,.0f} excess readmissions<extra></extra>'))
    fig.update_xaxes(title='Estimated excess readmissions',
                     range=[0, s['Gross excess readmissions'].max() * 1.15])
    return style(fig)


def chart_share(summary):
    total = summary['Gross excess readmissions'].sum()
    fig = go.Figure(go.Pie(
        labels=summary['Condition'], values=summary['Gross excess readmissions'], hole=0.62,
        marker=dict(colors=[color_of(c) for c in summary['Condition']],
                    line=dict(color='white', width=3)),
        sort=False, textinfo='percent', textfont=dict(color='white', size=13),
        texttemplate=['%{percent:.0%}' if v / total >= 0.05 else '' for v in summary['Gross excess readmissions']],
        hovertemplate='%{label}: %{value:,.0f} (%{percent})<extra></extra>'))
    fig.add_annotation(text=f'<b>{total:,.0f}</b><br>excess<br>readmissions',
                       showarrow=False, font=dict(size=15, color=NAVY))
    fig.update_layout(showlegend=True, legend=dict(orientation='h', y=-0.08, x=0.5, xanchor='center'))
    return style(fig)


def chart_split(summary):
    s = summary.sort_values('% worse than expected')
    worse = s['% worse than expected']
    fig = go.Figure()
    fig.add_bar(y=s['Condition'], x=worse, orientation='h', name='Worse than expected',
                marker_color=WORSE, text=[f'{v:.1f}%' for v in worse], textposition='inside',
                insidetextanchor='start', hovertemplate='%{y}: %{x:.1f}% worse<extra></extra>')
    fig.add_bar(y=s['Condition'], x=100 - worse, orientation='h', name='As expected or better',
                marker_color=BETTER, text=[f'{100 - v:.1f}%' for v in worse], textposition='inside',
                insidetextanchor='end', hovertemplate='%{y}: %{x:.1f}% as expected or better<extra></extra>')
    fig.add_vline(x=50, line_dash='dot', line_color=NAVY, line_width=2)
    fig.update_layout(barmode='stack', legend=dict(orientation='h', y=-0.15, x=0.5, xanchor='center'))
    fig.update_xaxes(range=[0, 100], ticksuffix='%')
    fig.update_traces(textfont=dict(color='white'))
    return style(fig)


def chart_net_gross(summary):
    s = summary.sort_values('Gross excess readmissions', ascending=False)
    fig = go.Figure()
    fig.add_bar(x=s['Condition'], y=s['Gross excess readmissions'], name='Gross (hospitals above expected)',
                marker_color=WORSE, hovertemplate='%{x}: %{y:,.0f}<extra>Gross</extra>')
    fig.add_bar(x=s['Condition'], y=s['Net excess readmissions'], name='Net (after better hospitals offset)',
                marker_color=NAVY, hovertemplate='%{x}: %{y:,.0f}<extra>Net</extra>')
    fig.add_hline(y=0, line_color='#8D99AE')
    fig.update_xaxes(tickangle=0, tickvals=list(s['Condition']),
                     ticktext=[c.replace(' ', '<br>', 1) for c in s['Condition']])
    fig.update_layout(barmode='group', legend=dict(orientation='h', y=-0.25, x=0.5, xanchor='center'))
    fig.update_yaxes(title='Readmissions')
    return style(fig)


ERR_SCALE = [[0, BETTER], [0.5, '#F8F9FB'], [1, WORSE]]


def chart_map(by_state, condition):
    span = max(abs(by_state['Weighted ERR'] - 1).max(), 0.01)
    fig = go.Figure(go.Choropleth(
        locations=by_state['State'], z=by_state['Weighted ERR'], locationmode='USA-states',
        colorscale=ERR_SCALE, zmin=1 - span, zmax=1 + span, zmid=1,
        marker_line_color='white', marker_line_width=1,
        colorbar=dict(title='ERR', thickness=12, len=0.8),
        hovertemplate='%{location}: %{z:.3f}<extra></extra>'))
    fig.update_geos(scope='usa', bgcolor='rgba(0,0,0,0)', showlakes=False)
    return style(fig, height=430)


def chart_rank(by_state, n=8):
    s = by_state.sort_values('Weighted ERR')
    pick = pd.concat([s.head(n), s.tail(n)]).drop_duplicates()
    fig = go.Figure(go.Bar(
        x=pick['Weighted ERR'] - 1, y=pick['State'], orientation='h', base=1,
        marker_color=[WORSE if v > 1 else BETTER for v in pick['Weighted ERR']],
        text=[f'{v:.3f}' for v in pick['Weighted ERR']], textposition='outside',
        hovertemplate='%{y}: %{text}<extra></extra>'))
    fig.add_vline(x=1, line_color=NAVY, line_width=2)
    lo, hi = pick['Weighted ERR'].min(), pick['Weighted ERR'].max()
    pad = (hi - lo) * 0.25
    fig.update_xaxes(range=[lo - pad, hi + pad], title='Weighted ERR (1.0 = as expected)')
    return style(fig, height=430)


# ---------------- Page ----------------
def table_html(summary):
    mx = summary['Gross excess readmissions'].max()
    rows = ''
    for _, r in summary.iterrows():
        col = color_of(r['Condition'])
        w = r['Gross excess readmissions'] / mx * 100
        rows += (f'<tr><td><span class="dot" style="background:{col}"></span>{r["Condition"]}</td>'
                 f'<td>{int(r["Hospitals"]):,}</td><td>{r["% worse than expected"]:.1f}%</td>'
                 f'<td>{r["Weighted ERR"]:.3f}</td><td>{r["Net excess readmissions"]:,.0f}</td>'
                 f'<td><div class="barcell"><div class="bar" style="width:{w:.0f}%;background:{col}"></div>'
                 f'<span>{r["Gross excess readmissions"]:,.0f}</span></div></td></tr>')
    return ('<table><thead><tr><th>Condition</th><th>Hospitals</th><th>% worse</th>'
            '<th>Weighted ERR</th><th>Net excess</th><th>Gross excess</th></tr></thead>'
            f'<tbody>{rows}</tbody></table>')


