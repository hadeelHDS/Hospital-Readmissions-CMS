def build_html(summary, by_state, condition, state_label, period, n_before, n_dropped):
    summary = summary.sort_values('Gross excess readmissions', ascending=False).reset_index(drop=True)
    records = int(summary['Hospitals'].sum())
    pct_worse = (summary['% worse than expected'] * summary['Hospitals']).sum() / records
    total = summary['Gross excess readmissions'].sum()
    top, second = summary.iloc[0], summary.iloc[1]
    top2_share = (top['Gross excess readmissions'] + second['Gross excess readmissions']) / total
    lo, hi = summary['% worse than expected'].min(), summary['% worse than expected'].max()
    neg = summary[summary['Net excess readmissions'] < 0]['Condition'].tolist()
    bs = by_state.sort_values('Weighted ERR', ascending=False)
    n_above = int((bs['Weighted ERR'] > 1).sum())

    kpis = [
        ('Hospital–condition records', f'{records:,}', 'after removing rows with no ERR', '#3A86FF'),
        ('Worse than expected', f'{pct_worse:.1f}%', 'of all hospital results', WORSE),
        ('Excess readmissions', f'{total:,.0f}', 'estimated patients (gross)', '#7B2CBF'),
        ('Biggest opportunity', top['Condition'], f"{top['Gross excess readmissions']:,.0f} excess readmissions",
         color_of(top['Condition'])),
    ]
    kpi_html = ''.join(f'<div class="kpi" style="background:{c}"><div class="label">{l}</div>'
                       f'<div class="value">{v}</div><div class="note">{n}</div></div>' for l, v, n, c in kpis)

    figs = [chart_excess(summary), chart_share(summary), chart_split(summary),
            chart_net_gross(summary), chart_map(by_state, condition), chart_rank(by_state)]
    h = [f.to_html(full_html=False, include_plotlyjs='cdn' if i == 0 else False, config=CONFIG)
         for i, f in enumerate(figs)]

    names = ' and '.join([', '.join(neg[:-1]), neg[-1]]) if len(neg) > 1 else (neg[0] if neg else '')
    net_note = f' For {names}, the net total is below zero.' if neg else ''

    def card(title, takeaway, body, accent):
        return (f'<div class="card" style="--accent:{accent}"><h2>{title}</h2>'
                f'<p class="takeaway">{takeaway}</p>{body}</div>')

    removed = (f'{n_dropped:,} of {n_before:,} rows ({n_dropped / n_before:.1%})'
               if n_before else '[add your numbers: N_BEFORE and N_DROPPED]')

    return f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hospital Readmissions Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;800&display=swap" rel="stylesheet">
<style>{CSS}</style></head><body>
<header><h1>Hospital Readmissions Dashboard</h1>
<p>{state_label} · Performance period {period} · Source: CMS Hospital Readmissions Reduction Program</p></header>
<main>
<section class="kpis">{kpi_html}</section>
<section class="grid">
{card('Where would improvement help most patients?',
      f"{top['Condition']} and {second['Condition']} account for {top2_share:.0%} of all excess readmissions.",
      h[0], color_of(top['Condition']))}
{card('Share of excess readmissions', 'Each colour is one condition, used the same way in every chart.', h[1], '#3A86FF')}
</section>
<section class="grid even">
{card('How widespread is the problem?',
      f'In every condition, about half of hospitals did worse than expected ({lo:.1f}% to {hi:.1f}%).', h[2], WORSE)}
{card('Gross vs net excess readmissions',
      'Hospitals that do better than expected offset those that do worse.' + net_note, h[3], NAVY)}
</section>
<section class="grid">
{card(f'{condition}: readmission ratio by state',
      f"{n_above} of {len(bs)} states are above 1.0 (red). Highest: {bs.iloc[0]['State']} ({bs.iloc[0]['Weighted ERR']:.3f}).",
      h[4], WORSE)}
{card('Highest and lowest states', 'Red = more readmissions than expected; teal = fewer.', h[5], BETTER)}
</section>
<section class="card" style="margin-bottom:20px"><h2>Summary by condition</h2>
<div class="tablewrap">{table_html(summary)}</div></section>
<section class="card method"><h2>Method and data notes</h2><ul>
<li>Rows without an Excess Readmission Ratio ("Too Few to Report", N/A) were removed</li>
<li><b>ERR</b> = Predicted ÷ Expected readmission rate, calculated by CMS with risk adjustment. ERR &gt; 1 means more readmissions than expected for the hospital's patients.</li>
<li><b>Weighted ERR</b> is weighted by Number of Discharges, so larger hospitals count more.</li>
<li><b>Excess readmissions</b> = (Predicted − Expected rate) ÷ 100 × Discharges. Gross counts only hospitals above expected; net lets better-than-expected hospitals offset them.</li>
</ul></section>
</main></body></html>"""


def summarise(data):
    g = data.groupby('Condition')
    return pd.DataFrame({
        'Hospitals': g.size(),
        '% worse than expected': g['worse_than_expected'].mean() * 100,
        'Weighted ERR': g['err_x_dis'].sum() / g['Number of Discharges'].sum(),
        'Net excess readmissions': g['excess_readmissions'].sum(),
        'Gross excess readmissions': g['excess_readmissions'].apply(lambda s: s[s > 0].sum()),
    }).reset_index()

